{
  "/api": {
    "target": "http://localhost:5000",
    "secure": false
  },
  "/static": {
    "target": "http://localhost:4200",
    "pathRewrite": { "^/static": "" },
    "secure": false
  },
  "/": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "withCredentials": true,
    "headers": {
      "Origin": "http://localhost:8080"
    }
  }
}
